# The models the APP talks to (not the model that wrote this code).
# Default: local Ollama, no key, no cost.
#   ollama serve && ollama pull qwen3:1.7b && ollama pull nomic-embed-text
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=qwen3:1.7b
# collections-manager reads these for the embeddings:
OPENAI_ENDPOINT=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text

# Retrieval — configuration, not constants.
TOP_K=4
THRESHOLD=0.55

# Chunking — configuration, not constants.
CHUNK_STRATEGY=sections   # sections | chars
SECTION_LEVEL=2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
